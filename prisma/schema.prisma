generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Modelo de Organización / Municipio (Multitenant SaaS)
model Tenant {
  id             String    @id @default(uuid())
  slug           String    @unique // ej: "quijos", "archidona", "tena"
  name           String    // ej: "GAD Municipal del Cantón Quijos"
  canton         String    // ej: "Quijos"
  province       String    @default("Napo")
  logoUrl        String?
  isActive       Boolean   @default(true)
  parishes       Json      // Array JSON con nombres de parroquias ["Baeza", "Cosanga", ...]
  aiPromptMaster String?   @db.LongText
  plan           String    @default("ENTERPRISE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  users          User[]
  reports        Report[]
}

// Usuarios Administradores de la Plataforma
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(MODERATOR)
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// Reportes Ciudadanos
model Report {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Código de ticket para seguimiento ciudadano (ej. QUI-2026-0001)
  ticketCode       String?  @unique

  title            String
  category         Category
  urgency          Urgency
  department       Department @default(OBRAS_PUBLICAS)
  parish           String
  neighborhood     String
  description      String   @db.Text
  
  // Evidencia Inicial (Galería de fotos de la queja)
  photos           Json? 
  
  // Datos Opcionales del Ciudadano
  citizenName      String?
  citizenContact   String?
  privacyAccepted  Boolean  @default(false)

  // Estado y Apoyo
  status           ReportStatus @default(RECEIVED)
  votes            Int          @default(0)

  // Cierre Técnico y Evidencia de Solución ("Antes vs Después")
  resolutionNotes  String?  @db.Text
  resolutionPhotos Json?
  resolvedAt       DateTime?

  // Análisis IA persistido
  aiAnalysis       String?  @db.LongText

  // Relaciones
  comments         Comment[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, department])
}

model Comment {
  id               String   @id @default(uuid())
  text             String   @db.Text
  citizenName      String?
  reportId         String
  report           Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  status           CommentStatus @default(APPROVED)
  
  createdAt        DateTime @default(now())
}

enum CommentStatus {
  APPROVED
  REJECTED
}

enum Role {
  SUPERADMIN
  ADMIN
  MODERATOR
}

enum Category {
  INFRASTRUCTURE
  SECURITY
  WATER
  SERVICES
  ENVIRONMENT
  EDUCATION
  OTHER
}

enum Department {
  OBRAS_PUBLICAS
  AGUA_SANEAMIENTO
  SERVICIOS_PUBLICOS
  SEGURIDAD_CIUDADANA
  PLANIFICACION_AMBIENTE
  OTRO
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
}

enum ReportStatus {
  RECEIVED
  IN_REVIEW
  IN_PROGRESS
  RESOLVED
  REJECTED
}

// Configuración Global de la Plataforma
model SystemSettings {
  id             String   @id @default("global")
  platformName   String   @default("Plataforma Ciudadana SaaS")
  aiPromptMaster String   @db.LongText
  updatedAt      DateTime @updatedAt
}
