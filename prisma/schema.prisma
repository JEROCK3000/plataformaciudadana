generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Modelo de Organización / Municipio (Multitenant SaaS)
model Tenant {
  id             String    @id @default(uuid())
  slug           String    @unique // ej: "quijos", "archidona", "tena"
  name           String    // ej: "GAD Municipal del Cantón Quijos"
  canton         String    // ej: "Quijos"
  province       String    @default("Napo")
  logoUrl        String?
  isActive       Boolean   @default(true)
  parishes       Json      // Array JSON con nombres de parroquias ["Baeza", "Cosanga", ...]
  aiPromptMaster String?   @db.LongText
  plan           String    @default("ENTERPRISE")
  requireCedulaForVotes Boolean @default(false)
  
  // Modo Campaña Política vs Institucional
  campaignMode          Boolean   @default(false)
  candidateName         String?
  campaignSlogan        String?
  campaignListNumber    String?
  candidatePhotoUrl     String?   @db.LongText
  partyLogoUrl          String?   @db.LongText

  // Terminología y Tratamiento Ciudadano Configurable (Ciudadano/a, Vecino/a, Amigo/a, etc.)
  citizenTermSingularM  String    @default("Ciudadano")
  citizenTermSingularF  String    @default("Ciudadana")
  citizenTermPlural     String    @default("Ciudadanos")

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  users          User[]
  reports        Report[]
  recintos       ElectoralRecinto[]
  juntas         ElectoralJunta[]
  actas          ElectoralActa[]
  scenarios      CampaignScenario[]
  activities     CampaignActivity[]
  voters         VoterRoll[]
}

// Usuarios Administradores de la Plataforma
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(MODERATOR)
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// Reportes Ciudadanos
model Report {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Código de ticket para seguimiento ciudadano (ej. QUI-2026-0001)
  ticketCode       String?  @unique

  title            String
  category         Category
  urgency          Urgency
  department       Department @default(OBRAS_PUBLICAS)
  parish           String
  neighborhood     String
  description      String   @db.Text
  
  // Evidencia Inicial (Galería de fotos de la queja)
  photos           Json? 
  
  // Datos Opcionales del Ciudadano
  citizenName      String?
  citizenContact   String?
  privacyAccepted  Boolean  @default(false)

  // Estado y Apoyo
  status           ReportStatus @default(RECEIVED)
  votes            Int          @default(0)

  // Cierre Técnico y Evidencia de Solución ("Antes vs Después")
  resolutionNotes  String?  @db.Text
  resolutionPhotos Json?
  resolvedAt       DateTime?

  // Análisis IA persistido
  aiAnalysis       String?  @db.LongText

  // Relaciones
  comments         Comment[]
  votesList        ReportVote[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, department])
}

model Comment {
  id               String   @id @default(uuid())
  text             String   @db.Text
  citizenName      String?
  reportId         String
  report           Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  status           CommentStatus @default(APPROVED)
  
  createdAt        DateTime @default(now())
}

// Votos y Apoyos Ciudadanos a Iniciativas
model ReportVote {
  id         String   @id @default(uuid())
  reportId   String
  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  voterHash  String   // SHA-256 de identificador anónimo de dispositivo + IP
  cedula     String?  // Opcional si se requiere cédula
  createdAt  DateTime @default(now())

  @@unique([reportId, voterHash])
  @@index([reportId])
}

enum CommentStatus {
  APPROVED
  REJECTED
}

enum Role {
  SUPERADMIN
  ADMIN
  MODERATOR
}

enum Category {
  INFRASTRUCTURE
  SECURITY
  WATER
  SERVICES
  ENVIRONMENT
  EDUCATION
  OTHER
}

enum Department {
  OBRAS_PUBLICAS
  AGUA_SANEAMIENTO
  SERVICIOS_PUBLICOS
  SEGURIDAD_CIUDADANA
  PLANIFICACION_AMBIENTE
  OTRO
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
}

enum ReportStatus {
  RECEIVED
  IN_REVIEW
  IN_PROGRESS
  RESOLVED
  REJECTED
}

// Configuración Global de la Plataforma
model SystemSettings {
  id             String   @id @default("global")
  platformName   String   @default("Plataforma Ciudadana SaaS")
  aiPromptMaster String   @db.LongText
  updatedAt      DateTime @updatedAt
}

// ============================================================
// MÓDULO DE CONTROL ELECTORAL Y DÍA D (E-DAY WAR MACHINE)
// ============================================================

enum JuntaGender {
  MASCULINO
  FEMENINO
  MIXTO
}

enum DelegateStatus {
  PENDIENTE
  CONFIRMADO
  EN_MESA
  AUSENTE
}

enum ActaStatus {
  PENDIENTE
  DIGITADA
  VERIFICADA
  IMPUGNADA
}

model ElectoralRecinto {
  id              String           @id @default(uuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name            String           // Ej: "Unidad Educativa Baeza"
  parish          String           // Ej: "Baeza", "San Francisco de Borja", etc.
  address         String?          // Ej: "Av. de los Quijos y 12 de Febrero"
  electors        Int              @default(0) // Total empadronados en el recinto
  coordinatorName String?          // Coordinador de recinto
  coordinatorPhone String?         // Teléfono / WhatsApp del coordinador

  juntas          ElectoralJunta[]
  voters          VoterRoll[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([tenantId, parish])
}

model ElectoralJunta {
  id              String           @id @default(uuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recintoId       String
  recinto         ElectoralRecinto @relation(fields: [recintoId], references: [id], onDelete: Cascade)

  juntaNumber     Int              // Número de Junta: 1, 2, 3...
  gender          JuntaGender      @default(MASCULINO)
  electors        Int              @default(350) // Número de electores empadronados

  delegateName    String?          // Nombre del delegado / veedor de mesa
  delegatePhone   String?          // Teléfono / WhatsApp
  delegateStatus  DelegateStatus   @default(PENDIENTE)

  acta            ElectoralActa?
  voters          VoterRoll[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([recintoId, juntaNumber, gender])
  @@index([tenantId])
}

model ElectoralActa {
  id               String          @id @default(uuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  juntaId          String          @unique
  junta            ElectoralJunta  @relation(fields: [juntaId], references: [id], onDelete: Cascade)

  candidateVotes   Int             @default(0)
  rivalVotes       Int             @default(0)
  otherVotes       Int             @default(0)
  blankVotes       Int             @default(0)
  nullVotes        Int             @default(0)
  totalVoters      Int             @default(0)

  photoUrl         String?         @db.LongText
  status           ActaStatus      @default(DIGITADA)
  hasInconsistency Boolean         @default(false)
  inconsistencyNote String?        @db.Text
  digitizedBy      String?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([tenantId, status])
}

// ============================================================
// ENUMS DE LOS NUEVOS MÓDULOS ESTRATÉGICOS
// ============================================================

enum ActivityType {
  CAMINATA
  CARAVANA
  MITIN
  REUNION_VECINAL
  PUERTA_A_PUERTA
  BRIGADA_COMUNITARIA
  VOLANTEO_FERIA
  OTRO
}

enum ActivityStatus {
  PLANIFICADA
  CONFIRMADA
  EN_CURSO
  COMPLETADA
  CANCELADA
}

enum CommitmentLevel {
  SEGURO
  PROBABLE
  INDECISO
  RIVAL
}

// ============================================================
// MÓDULO 1: CALCULADORA DEL UMBRAL DE VICTORIA CANTONAL
// ============================================================

model CampaignScenario {
  id                   String    @id @default(uuid())
  tenantId             String
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name                 String    // Ej: "Escenario Base Seccionales", "Escenario Meta Máxima"
  description          String?   @db.Text
  expectedTurnoutRate  Float     @default(86.0) // Porcentaje de participación esperada (ej: 86%)
  nullBlankRate        Float     @default(11.5) // Porcentaje estimado de blancos y nulos (ej: 11.5%)
  targetCandidateVotes Int       @default(1750) // Meta votos Brandon Aliaga
  
  // Metas detalladas por Parroquia en formato JSON
  parishGoals          Json
  
  // Estimaciones de votación para rivales en formato JSON
  rivalEstimates       Json?

  isDefault            Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([tenantId])
}

// ============================================================
// MÓDULO 2: AGENDA TÁCTICA DE TERRITORIO Y CAMINATAS
// ============================================================

model CampaignActivity {
  id                 String          @id @default(uuid())
  tenantId           String
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title              String          // Ej: "Caminata y Puerta a Puerta Barrio Central y Mercado"
  type               ActivityType    @default(CAMINATA)
  parish             String          // Baeza, San Francisco de Borja, Cosanga, etc.
  sector             String          // Barrio, Caserío o Sector específico
  date               DateTime        // Fecha y hora programada
  status             ActivityStatus  @default(PLANIFICADA)

  responsibleName    String?         // Nombre del jefe de avanzada o brigadista líder
  responsiblePhone   String?         // Contacto telefónico
  meetingPoint       String?         // Punto de concentración (ej. Frente al Parque Central)
  
  estimatedAttendees Int             @default(0)
  actualAttendees    Int             @default(0)

  logisticsNotes     String?         @db.Text // Banderas, volantes, megáfono, transporte, refrigerios
  speechFocus        String?         @db.Text // Ejes del discurso (vinculado a necesidades ciudadanas)
  relatedCategory    Category?       // Categoría principal del reclamo ciudadano que se abordará

  photos             Json?           // Fotos de la actividad
  notes              String?         @db.Text

  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([tenantId, parish])
  @@index([tenantId, date])
  @@index([tenantId, status])
}

// ============================================================
// MÓDULO 3: PADRÓN ELECTORAL Y CHEQUEO DÍA D (VOTO SEGURO)
// ============================================================

model VoterRoll {
  id                 String           @id @default(uuid())
  tenantId           String
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  cedula             String
  fullName           String
  parish             String           // Parroquia
  
  recintoId          String?
  recinto            ElectoralRecinto? @relation(fields: [recintoId], references: [id], onDelete: SetNull)
  
  juntaId            String?
  junta              ElectoralJunta?  @relation(fields: [juntaId], references: [id], onDelete: SetNull)
  
  juntaNumber        Int?             // Número de JRV
  gender             JuntaGender?     // Femenino / Masculino / Mixto

  phone              String?
  neighborhood       String?          // Barrio o comunidad de residencia
  
  commitmentLevel    CommitmentLevel  @default(SEGURO) // SEGURO, PROBABLE, INDECISO, RIVAL
  isSympathizer      Boolean          @default(true)

  // Control en tiempo real durante el Día D
  hasVoted           Boolean          @default(false)
  votedAt            DateTime?

  // Movilización y Logística el Día de la Elección
  needsTransport     Boolean          @default(false)
  transportAddress   String?          // Dirección para recogida si requiere vehículo
  volunteerAssigned  String?          // Brigadista o taxista asignado para la movilización

  notes              String?          @db.Text

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([tenantId, cedula])
  @@index([tenantId, parish])
  @@index([tenantId, hasVoted])
  @@index([tenantId, commitmentLevel])
  @@index([tenantId, recintoId])
}

